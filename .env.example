# Copie para .env e ajuste os valores.

DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Porta no seu computador (http://localhost:WEB_PORT)
WEB_PORT=8000

POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=agendamento
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mail dos convites para colaboradores. Sem EMAIL_HOST, os e-mails só aparecem no log (docker compose logs web).
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Agendamento <nao-responda@seudominio.com>

# --- Produção (ver "Deploy" no README) ---
# POSTGRES_SSLMODE=require      # bancos gerenciados (Neon etc.)
# POSTGRES_POOLER=1             # só se o host for de pooler (PgBouncer, "-pooler" no Neon)
# PROXIES_CONFIAVEIS=1          # proxies na frente do app (Render: 1)
# GERENTE_EMAIL=voce@exemplo.com  # cria o primeiro usuário no deploy, se ainda não existir
# GERENTE_SENHA=

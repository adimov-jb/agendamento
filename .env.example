# Copie para .env e ajuste os valores.

DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Porta no seu computador (http://localhost:WEB_PORT)
WEB_PORT=8000

POSTGRES_DB=agendamento
POSTGRES_USER=agendamento
POSTGRES_PASSWORD=agendamento
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Produção (ver "Deploy" no README) ---
# POSTGRES_SSLMODE=require      # bancos gerenciados (Neon etc.)
# POSTGRES_POOLER=1             # só se o host for de pooler (PgBouncer, "-pooler" no Neon)
# PROXIES_CONFIAVEIS=1          # proxies na frente do app (Render: 1)
# GERENTE_EMAIL=voce@clinica.com  # cria o primeiro gerente no deploy, se ainda não existir
# GERENTE_SENHA=
